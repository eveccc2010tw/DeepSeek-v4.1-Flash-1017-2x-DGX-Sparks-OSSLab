+    /// Rolling progress marks past `from` up to half a gap before history_len (or cap), min_gap apart.
+    pub fn progressMarks(s: *const Store, a: Allocator, prompt: []const u32, from: u32, history_len: u32, starts: []const u32, others: []const u32) ![]const u32 {
