+    try std.testing.expect(s2.find(&conv_b, &.{}) == null);
+    try std.testing.expectEqual(@as(u32, 16), s2.find(conv_a[0..18], &.{}).?.at);
+    try std.testing.expectEqual(@as(u32, 36), s2.find(conv_a[0..40], &.{}).?.at);
+    try std.testing.expectEqual(@as(u32, 16), s2.find(&conv_c, &.{}).?.at);
