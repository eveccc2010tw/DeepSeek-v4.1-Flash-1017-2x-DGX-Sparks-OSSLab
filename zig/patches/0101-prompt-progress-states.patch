+test "progress states: none unless set; every gap past the resume point, up to half a gap before the history" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_gap = 2, .min_prompt = 0 }, 1 << 20);
+    defer s.deinit();
+    const prompt = ramp(64, 3);
+    try std.testing.expectEqualSlices(u32, &.{}, try s.progressMarks(a, &prompt, 0, 56, &.{}, &.{56}));
+    s.rules.progress_gap = 8;
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40, 48 }, try s.progressMarks(a, &prompt, 0, 56, &.{}, &.{56}));
+    try std.testing.expectEqualSlices(u32, &.{ 24, 32, 40, 48 }, try s.progressMarks(a, &prompt, 20, 56, &.{}, &.{56}));
+    try std.testing.expectEqualSlices(u32, &.{ 32, 40, 48 }, try s.progressMarks(a, &prompt, 23, 56, &.{}, &.{56}));
+    try std.testing.expectEqualSlices(u32, &.{ 24, 40, 48 }, try s.progressMarks(a, &prompt, 20, 56, &.{}, &.{ 33, 56 }));
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40, 48, 56 }, try s.progressMarks(a, &prompt, 0, 0, &.{}, &.{}));
+    s.rules.min_prompt = 65;
+    try std.testing.expectEqualSlices(u32, &.{}, try s.progressMarks(a, &prompt, 0, 56, &.{}, &.{56}));
+    // Lookup lists progress marks both in `marks` and separately in `progress`.
+    s.rules.min_prompt = 0;
+    const l = try s.lookup(a, &prompt, 56, &.{}, &.{});
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40, 48, 56 }, l.marks);
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40, 48 }, l.progress);
+    // With a native grid and replay window, progress marks land on grid chunk ends before the replay window.
+    s.rules.grid = 4;
+    s.rules.window = 8;
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40, 48 }, try s.progressMarks(a, &prompt, 0, 0, &.{}, &.{}));
+    try std.testing.expectEqualSlices(u32, &.{ 8, 16, 24, 32, 40 }, try s.progressMarks(a, &prompt, 0, 58, &.{}, &.{50}));
+}
+
+test "an interrupted pass resumes from its last progress state, equal to a fresh pass; without progress states it starts over" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const prompt = ramp(64, 3);
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_gap = 2, .min_prompt = 0, .progress_gap = 8 }, 1 << 20);
+    defer s.deinit();
+    // Client cancels 43 tokens in: progress states at 8..40 roll forward, retiring earlier ones.
+    try std.testing.expectEqual(@as(?u64, null), try progressPass(&f, &s, a, &prompt, 62, &.{}, 43));
+    try std.testing.expectEqual(@as(usize, 1), s.entries.items.len);
+    try std.testing.expectEqual(@as(u32, 40), s.entries.items[0].at);
+    try std.testing.expect(s.entries.items[0].progress);
+    try std.testing.expectEqual(@as(u64, 5), s.counts.kept);
+    try std.testing.expectEqual(@as(usize, 1), f.live);
+    // Retry resumes at 40 and retires progress states once the durable history mark at 62 is kept.
+    try std.testing.expectEqual(@as(?u64, fresh(&prompt)), try progressPass(&f, &s, a, &prompt, 62, &.{}, null));
+    try std.testing.expectEqual(@as(u64, 1), s.counts.hits);
+    try std.testing.expectEqual(@as(usize, 1), s.entries.items.len);
+    try std.testing.expectEqual(@as(u32, 62), s.entries.items[0].at);
+    try std.testing.expect(!s.entries.items[0].progress);
+    try std.testing.expectEqual(@as(usize, 1), f.live);
+    try std.testing.expectEqual(@as(u64, 0), s.counts.evicted);
+    // Without progress states, the same interruption keeps nothing and retries from 0.
+    var g: Fake = .{ .gpa = gpa };
+    var off = Store.init(gpa, g.snapshots(), .{ .min_gap = 2, .min_prompt = 0 }, 1 << 20);
+    defer off.deinit();
+    try std.testing.expectEqual(@as(?u64, null), try progressPass(&g, &off, a, &prompt, 62, &.{}, 43));
+    try std.testing.expectEqual(@as(usize, 0), off.entries.items.len);
+    try std.testing.expectEqual(@as(?u64, fresh(&prompt)), try progressPass(&g, &off, a, &prompt, 62, &.{}, null));
+    try std.testing.expectEqual(@as(u64, 0), off.counts.hits);
+}
+
+test "a progress state yields only same-prefix shallower states: other conversations' branch points and progress states stay" {
+    const gpa = std.testing.allocator;
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
