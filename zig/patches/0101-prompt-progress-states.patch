+/// TF_DS_PROMPT_PROGRESS_TOKENS: rolling progress interval rounded down to chunk ends (>= 4 chunks; else 0).
+fn progressGap(text: ?[]const u8, rows: u32) u32 {
+    const n = (envNumber(text) catch return 0) orelse return 0;
+    if (rows == 0 or n < 4 * rows) return 0;
+    return n / rows * rows;
+}
+
+test "prompt progress states: off unless set, whole chunks, at least four of them" {
+    try std.testing.expectEqual(@as(u32, 0), progressGap(null, 2048));
+    try std.testing.expectEqual(@as(u32, 0), progressGap("0", 2048));
+    try std.testing.expectEqual(@as(u32, 0), progressGap("x", 2048));
+    try std.testing.expectEqual(@as(u32, 0), progressGap("8191", 2048));
+    try std.testing.expectEqual(@as(u32, 8192), progressGap("8192", 2048));
+    try std.testing.expectEqual(@as(u32, 65536), progressGap("66000", 2048));
+}
+
