+    try std.testing.expectEqual(@as(u32, 16), prog32.origin_fork);
+
+    // Retry of Turn 2 resumes prog32 (inheriting origin_point=p1_id, fork=16), keeps 40, then keeps durable 56.
+    const parent = prog32.point orelse prog32.origin_point;
