+    defer s2.deinit();
+    try std.testing.expectEqual(@as(?u64, fresh(conv_a[0..20])), try progressPass(&f2, &s2, a, conv_a[0..20], 16, &.{}, null));
+    try std.testing.expectEqual(@as(?u64, fresh(conv_a[0..40])), try progressPass(&f2, &s2, a, conv_a[0..40], 36, &.{}, null));
