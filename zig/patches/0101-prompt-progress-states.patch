     fn pieces(x: *Fake, s: *Stream, chunks: usize) !bool {
+        if (x.incremental) return x.prefillIncremental(s, chunks);
         const l = x.lanes.getPtr(s).?;
         const total = if (x.prefill_chunks == 0) 1 else x.prefill_chunks;
         var ran: usize = 0;
@@ -156,6 +159,40 @@ pub const Fake = struct {
         return true;
     }
 
+    /// Copy kept prefix tokens, then run equal chunks from 0, keeping marks and checking cancel after chunk 0.
+    fn prefillIncremental(x: *Fake, s: *Stream, budget: usize) anyerror!bool {
+        const l = x.lanes.getPtr(s).?;
+        if (l.pieces == 0) {
+            s.cached = 0;
+            const h = &l.history;
+            if (s.reuse.saved) |saved| {
+                const kept: *std.ArrayList(u32) = @ptrCast(@alignCast(saved));
+                try h.appendSlice(x.gpa, kept.items);
+                s.cached = s.reuse.at;
+            }
+        }
+        const prompt = s.prompt();
+        const chunks = if (x.prefill_chunks == 0) 1 else x.prefill_chunks;
+        const step = @max(1, (prompt.len + chunks - 1) / chunks);
+        var ran: usize = 0;
+        while (ran < budget) : (ran += 1) {
+            const done = x.lanes.getPtr(s).?.history.items.len;
+            if (done >= prompt.len) return true;
+            const chunk = done / step;
+            x.prefill_count += 1;
+            if (x.prefill_hook) |hook| hook(x.prefill_hook_ctx.?, s, chunk);
+            if (done > 0 and s.isCancelled()) return error.Cancelled; // (dsv41: `start > 0 and s.isCancelled()`)
+            x.lanes.getPtr(s).?.pieces += 1;
+            const end = @min(prompt.len, (chunk + 1) * step);
+            for (prompt[done..end], done + 1..) |t, at| {
+                try x.lanes.getPtr(s).?.history.append(x.gpa, t);
+                if (std.mem.indexOfScalar(u32, s.reuse.marks, @intCast(at)) != null) if (s.reuse.hook) |k| k.at(k.ptr, s, @intCast(at));
+            }
+            if (end < prompt.len) if (s.between) |b| if (b.wanted(b.ptr)) try b.run(b.ptr);
+        }
+        return x.lanes.getPtr(s).?.history.items.len >= prompt.len;
+    }
+
     /// A copy of the stream's cache at `at` tokens (the prompt pass stands there), for core/prompt_cache.zig.
     pub fn save(x: *Fake, s: *Stream, at: u32) !*anyopaque {
         const l = x.lane(s);
