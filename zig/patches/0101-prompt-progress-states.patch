+    try std.testing.expectEqual(@as(u32, 16), fork);
+    const lin3 = try s.passLineage(prog32);
+    defer gpa.free(lin3);
+    s.resumed(prog32, &p, true);
+    try std.testing.expect(keepAt(&s, &f, &p, 40, .{ .group = j1.group, .parent = parent, .fork = fork, .lineage = lin3, .progress = true }));
+    try std.testing.expectEqual(@as(u64, 1), s.stats.writes_enqueued); // still zero progress writes!
+    try std.testing.expect(keepAt(&s, &f, &p, 56, .{ .group = j1.group, .parent = parent, .fork = fork, .lineage = lin3, .progress = false }));
+    s.pump(1000);
+    // Final mark 56 retired 32 & 40 and enqueued exactly ONE new durable point P2 whose parent is P1 at fork 16!
+    try std.testing.expectEqual(@as(u64, 2), s.stats.writes_enqueued);
+    try std.testing.expectEqual(@as(usize, 2), tier.points.items.len);
+    const e56 = s.find(&p, &.{}) orelse unreachable;
+    try std.testing.expectEqual(@as(u32, 56), e56.at);
+    try std.testing.expect(!e56.progress and e56.point != null);
+    const p2 = tier.point(e56.point.?).?;
+    try std.testing.expectEqual(@as(?u64, p1_id), p2.parent);
+    try std.testing.expectEqual(@as(u32, 16), p2.fork);
+    // Only e1 (16) and e56 (56) remain in RAM (progress states 24, 32, 40 were all retired).
+    try std.testing.expectEqual(@as(usize, 2), s.entries.items.len);
+    try std.testing.expectEqual(@as(usize, 2), f.live);
+
+    // Promoting a progress state in place enqueues it to the spill tier with its origin_point and origin_fork.
+    const q = seq(64, 201);
+    const lin_q = try s.passLineage(null);
+    defer gpa.free(lin_q);
+    try std.testing.expect(keepAt(&s, &f, &q, 24, .{ .group = 99, .parent = p1_id, .fork = 16, .lineage = lin_q, .progress = true }));
+    try std.testing.expectEqual(@as(u64, 2), s.stats.writes_enqueued);
+    try std.testing.expect(keepAt(&s, &f, &q, 24, .{ .group = 99, .lineage = lin_q, .progress = false }));
+    s.pump(1000);
+    try std.testing.expectEqual(@as(u64, 3), s.stats.writes_enqueued);
+    const eq = s.find(&q, &.{}) orelse unreachable;
+    try std.testing.expect(!eq.progress and eq.point != null);
+    const pq = tier.point(eq.point.?).?;
+    try std.testing.expectEqual(@as(?u64, p1_id), pq.parent);
+    try std.testing.expectEqual(@as(u32, 16), pq.fork);
+}
