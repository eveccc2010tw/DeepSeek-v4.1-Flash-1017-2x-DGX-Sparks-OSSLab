diff --git a/zig/src/core/lane_host_reuse_test.zig b/zig/src/core/lane_host_reuse_test.zig
index afb30847..462d6e56 100644
--- a/zig/src/core/lane_host_reuse_test.zig
+++ b/zig/src/core/lane_host_reuse_test.zig
@@ -440,3 +440,114 @@ test "a turn resuming its kept state cuts in when the tokens it computes fit cut
     for (seen[first + 1 .. second]) |s| try std.testing.expectEqual(t2.items.len, s[0]);
     for (seen[second..]) |s| try std.testing.expect(s[0] != t2.items.len);
 }
+
+test "a pass its client leaves resumes from its last progress state on the retry, replying as an uninterrupted pass" {
+    const gpa = std.testing.allocator;
+    for ([_]u32{ 0, 8 }) |gap| for ([_]usize{ 0, 1, 2 }) |fill_chunks| {
+        var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+        defer cfg.deinit(gpa);
+        // dsv41's pass: a grid of 8-token chunks, each mark kept as its chunk reaches it, a cancel seen per chunk
+        var target: lanes.fake.Fake = .{ .gpa = gpa, .incremental = true, .prefill_chunks = 8 };
+        defer target.deinit();
+        var clock: lanes.fake.FixedClock = .{};
+        var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+        defer core.deinit();
+        core.fill_chunks = @intCast(fill_chunks);
+        core.cut_in = if (fill_chunks > 0) 8 else 0;
+        const Snaps = struct {
+            fn bytes(_: *anyopaque, at: u32) u64 {
+                return 64 + 4 * @as(u64, at);
+            }
+            fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+                const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+                return f.save(@ptrCast(@alignCast(owner.?)), at);
+            }
+            fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+                return error.BackendRestores;
+            }
+            fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+                const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+                f.drop(saved);
+            }
+        };
+        var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0, .progress_gap = gap }, 1 << 20);
+        defer store.deinit();
+        var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+        host.cache = &store;
+        const Cancel = struct {
+            engine: ?api.Engine = null,
+            id: Id = 0,
+            at: usize = 5,
+            armed: std.atomic.Value(bool) = .init(true),
+            fn call(ctx: *anyopaque, _: *lanes.Stream, chunk: usize) void {
+                const c: *@This() = @ptrCast(@alignCast(ctx));
+                if (chunk == c.at and c.armed.load(.acquire)) c.engine.?.cancel(c.id); // the client leaves 40 tokens in
+            }
+        };
+        var cancel: Cancel = .{};
+        target.prefill_hook = Cancel.call;
+        target.prefill_hook_ctx = &cancel;
+        try host.start();
+        defer host.stop();
+        const e = host.engine();
+        cancel.engine = e;
+        cancel.id = 1;
+        const Box = struct {
+            mutex: std.Io.Mutex = .init,
+            tokens: std.ArrayList(u32) = .empty,
+            cached: ?u32 = null,
+            done: ?Reason = null,
+            fn event(ctx: *anyopaque, _: Id, ev: *const Event) void {
+                const b: *@This() = @ptrCast(@alignCast(ctx));
+                b.mutex.lockUncancelable(std.testing.io);
+                defer b.mutex.unlock(std.testing.io);
+                switch (ev.*) {
+                    .prefilled => |c| b.cached = c,
+                    .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+                    .finished => |f| b.done = f.reason,
+                }
+            }
+            fn wait(b: *@This()) Reason {
+                while (true) {
+                    b.mutex.lockUncancelable(std.testing.io);
+                    const d = b.done;
+                    b.mutex.unlock(std.testing.io);
+                    if (d) |r| return r;
+                    std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+                }
+            }
+        };
+        var prompt: [64]u32 = undefined;
+        for (&prompt, 0..) |*t, i| t.* = @intCast((i * 7 + 3) % 97);
+        var b1: Box = .{};
+        defer b1.tokens.deinit(gpa);
+        const r1: Request = .{ .prompt = &prompt, .max_tokens = 6, .history_len = 62 };
+        try e.submit(1, &r1, .{ .ctx = &b1, .event = Box.event });
+        try std.testing.expectEqual(Reason.cancelled, b1.wait());
+        try std.testing.expectEqual(@as(usize, 0), b1.tokens.items.len);
+        // with progress states only the latest stays, at 40; without them nothing was kept
+        try std.testing.expectEqual(@as(usize, if (gap == 0) 0 else 1), store.entries.items.len);
+        if (gap > 0) try std.testing.expect(store.entries.items[0].progress and store.entries.items[0].at == 40);
+        cancel.armed.store(false, .release);
+        var b2: Box = .{};
+        defer b2.tokens.deinit(gpa);
+        const r2: Request = .{ .prompt = &prompt, .max_tokens = 6, .history_len = 62 };
+        try e.submit(2, &r2, .{ .ctx = &b2, .event = Box.event });
+        try std.testing.expectEqual(Reason.length, b2.wait());
+        try std.testing.expectEqual(@as(?u32, if (gap == 0) 0 else 40), b2.cached);
+        var history: std.ArrayList(u32) = .empty; // the fake's tokens read the whole history: any slip changes them
+        defer history.deinit(gpa);
+        try history.appendSlice(gpa, &prompt);
+        try std.testing.expectEqual(@as(usize, 6), b2.tokens.items.len);
+        for (b2.tokens.items) |t| {
+            try std.testing.expectEqual(lanes.fake.next(history.items, null, history.items.len), t);
+            try history.append(gpa, t);
+        }
+        // the retry's own progress states went once its history's state was kept
+        try std.testing.expectEqual(@as(usize, 1), store.entries.items.len);
+        try std.testing.expectEqual(@as(u32, 62), store.entries.items[0].at);
+        try std.testing.expect(!store.entries.items[0].progress);
+        try std.testing.expectEqual(@as(u64, if (gap == 0) 0 else 1), store.counts.hits);
+        try std.testing.expectEqual(@as(u64, 0), store.counts.evicted);
+    };
+}
