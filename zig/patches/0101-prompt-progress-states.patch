+        defer s.deinit();
+        try std.testing.expectEqual(@as(?u64, fresh(&other)), try progressPass(&f, &s, a, &other, 36, &.{}, null));
+        try std.testing.expectEqual(@as(usize, 1), s.entries.items.len);
+        try std.testing.expectEqual(@as(?u64, null), try progressPass(&f, &s, a, &prompt, 0, &.{}, 20));
+        try std.testing.expect(s.find(&other, &.{}) != null);
+        try std.testing.expectEqual(@as(u64, 0), s.counts.evicted);
+        try std.testing.expectEqual(@as(u64, 0), s.counts.refused);
+        try std.testing.expect(s.held <= s.budget);
+        if (budget == 260) {
+            try std.testing.expectEqual(@as(usize, 2), s.entries.items.len);
+            try std.testing.expectEqual(@as(u32, 16), s.find(&prompt, &.{}).?.at);
+        } else {
+            try std.testing.expectEqual(@as(usize, 1), s.entries.items.len);
+            try std.testing.expect(s.find(&prompt, &.{}) == null);
+        }
+        try std.testing.expectEqual(s.entries.items.len, f.live);
+    }
+    // Multi-conversation tight budget: A holds A0(16), stable(20), A1(36); C holds cancelled progress C_prog(16).
+    const conv_a = ramp(48, 21);
