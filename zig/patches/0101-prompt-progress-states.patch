+//! Rolling prompt progress state tests: grid marks, cancel+retry resume, same-prefix yield bounds, and OOM cleanup.
+const std = @import("std");
+const pc = @import("prompt_cache.zig");
+const Snapshots = pc.Snapshots;
+const Saved = pc.Saved;
+const Store = pc.Store;
+const Allocator = std.mem.Allocator;
+
+const Fake = struct {
+    gpa: Allocator,
+    at: u32 = 0,
+    sum: u64 = 0,
+    live: usize = 0,
+
+    const State = struct { at: u32, sum: u64 };
+
+    fn snapshots(f: *Fake) Snapshots {
+        return .{ .ptr = f, .vtable = &.{ .bytes = bytesFn, .save = saveFn, .restore = restoreFn, .drop = dropFn } };
+    }
+    fn of(ptr: *anyopaque) *Fake {
+        return @ptrCast(@alignCast(ptr));
+    }
+    fn bytesFn(_: *anyopaque, at: u32) u64 {
+        return 100 + at;
+    }
+    fn saveFn(ptr: *anyopaque, _: ?*anyopaque, at: u32) anyerror!Saved {
+        const f = of(ptr);
+        if (at != f.at) return error.NotAtMark;
+        const st = try f.gpa.create(State);
+        st.* = .{ .at = f.at, .sum = f.sum };
+        f.live += 1;
+        return st;
+    }
+    fn restoreFn(ptr: *anyopaque, _: ?*anyopaque, saved: Saved) anyerror!void {
+        const f = of(ptr);
+        const st: *State = @ptrCast(@alignCast(saved));
+        f.at, f.sum = .{ st.at, st.sum };
+    }
+    fn dropFn(ptr: *anyopaque, saved: Saved) void {
+        const f = of(ptr);
+        const st: *State = @ptrCast(@alignCast(saved));
+        f.gpa.destroy(st);
+        f.live -= 1;
+    }
+};
+
+fn fresh(prompt: []const u32) u64 {
+    var s: u64 = 0;
+    for (prompt) |t| s = s *% 31 +% t;
+    return s;
+}
+
+fn ramp(comptime n: usize, seed: u32) [n]u32 {
+    var out: [n]u32 = undefined;
+    for (&out, 0..) |*t, i| t.* = @intCast((i * 7 + seed) % 97);
+    return out;
+}
+
+/// Run a prompt pass like LaneHost, keeping progress/history marks and stopping before `stop` when cancelled.
+fn progressPass(f: *Fake, s: *Store, a: Allocator, prompt: []const u32, history_len: u32, shared: []const u32, stop: ?usize) !?u64 {
+    const l = try s.lookup(a, prompt, history_len, shared, &.{});
+    var from: u32 = 0;
+    f.at = 0;
+    f.sum = 0;
+    if (l.entry) |e| {
+        try Fake.restoreFn(f, null, e.saved);
+        s.resumed(e, prompt, true);
+        from = e.at;
+    }
+    for (prompt[from..]) |t| {
+        if (stop) |n| if (f.at >= n) return null;
+        f.sum = f.sum *% 31 +% t;
+        f.at += 1;
+        if (std.mem.indexOfScalar(u32, l.marks, f.at) != null)
+            _ = s.keepAs(prompt, f.at, null, &.{}, std.mem.indexOfScalar(u32, l.progress, f.at) != null);
+    }
+    return f.sum;
+}
