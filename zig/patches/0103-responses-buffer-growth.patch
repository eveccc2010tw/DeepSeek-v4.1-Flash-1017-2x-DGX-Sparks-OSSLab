+++ b/zig/src/server/root.zig
@@ -21,6 +21,7 @@ test {
     _ = @import("fields.zig");
     _ = @import("reply_text.zig");
     _ = @import("tool_parse.zig");
+    _ = @import("responses.zig");
     _ = @import("tool_stream.zig");
     _ = @import("dsml_stream_test.zig");
     _ = @import("dsml_fuzz_test.zig");
