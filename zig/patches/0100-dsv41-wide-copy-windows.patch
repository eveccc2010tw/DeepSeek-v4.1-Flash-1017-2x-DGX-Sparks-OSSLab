diff --git a/zig/src/core/lanes/copy_batch_test.zig b/zig/src/core/lanes/copy_batch_test.zig
new file mode 100644
index 00000000..27eebd1d
--- /dev/null
+++ b/zig/src/core/lanes/copy_batch_test.zig
@@ -0,0 +1,172 @@
+//! Lone and shared copy windows can omit speculative heads, never target verification or rollback.
+const std = @import("std");
+const config = @import("config.zig");
+const Engine = @import("engine.zig").Engine;
+const sm = @import("stream.zig");
+const fake = @import("fake.zig");
+const proposer = @import("proposer.zig");
+const Sampling = @import("sampling.zig").Sampling;
+const gpa = std.testing.allocator;
+
+const Mode = enum { copies, transition, mixed, rejected, budget, no_copies, single_copy_end };
+
+/// Deterministic proposer with misses and abrupt copy-end; proposals still go through the history-keyed fake target.
+const Copies = struct {
+    enabled: bool = true,
+    stop: usize = std.math.maxInt(usize),
+    reject: bool = false,
+    sampling: ?Sampling = null,
+    out: [32]u32 = undefined,
+
+    fn interface(c: *Copies) proposer.Proposer {
+        return .{ .ptr = c, .vtable = &.{ .propose = propose, .last_match = match } };
+    }
+    fn match(_: *anyopaque) i64 {
+        return 64;
+    }
+    fn propose(ptr: *anyopaque, context: []const u32, max: i64) ![]const u32 {
+        const c: *Copies = @ptrCast(@alignCast(ptr));
+        if (!c.enabled or context.len >= c.stop or max <= 0) return &.{};
+        var h: std.ArrayList(u32) = .empty;
+        defer h.deinit(gpa);
+        try h.appendSlice(gpa, context);
+        const n: usize = @intCast(@min(max, c.out.len));
+        for (c.out[0..n], 0..) |*t, i| {
+            t.* = fake.next(h.items, c.sampling, h.items.len);
+            if (c.reject and i == 0) t.* = (t.* + 1) % fake.vocab;
+            try h.append(gpa, t.*);
+        }
+        return c.out[0..n];
+    }
+};
+
+const Result = struct {
+    tokens: [4][]u32 = .{ &.{}, &.{}, &.{}, &.{} },
+    reasons: [4]sm.Reason = undefined,
+    calls: usize = 0,
+    drafted: usize = 0,
+    fn deinit(r: Result) void {
+        for (r.tokens) |t| gpa.free(t);
+    }
+};
+
+fn run(n: usize, mode: Mode, sampled: bool, skip: bool, master: bool) !Result {
+    var costs: [16]config.Cost = undefined;
+    for (&costs, 1..) |*c, w| c.* = .{ .width = @intCast(w), .ms = 5.0 + 0.8 * @as(f64, @floatFromInt(w)) };
+    var cfg = try config.Config.init(gpa, .{
+        .exact_width = 16,
+        .first_copy_rows = 6,
+        .gpu_tokens = true,
+        .mtp = true,
+        .speculate = true,
+        .speculate_early = false,
+        .drafts = 4,
+        .window_costs = &costs,
+        .mtp_step_ms = 0.5,
+        .hidden_rows = true,
+        .batch_rows = 32,
+        .max_streams = 4,
+        .draft_streams = true,
+        .copy_skips_head = master,
+        .copy_batch_skips_head = skip,
+        .copy_multi = 15,
+    }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var e = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer e.deinit();
+    var copies: [4]Copies = undefined;
+    var streams: [4]sm.Stream = undefined;
+    var made: usize = 0;
+    defer for (streams[0..made]) |*s| s.deinit(gpa);
+    const prompt = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6 };
+    for (0..n) |i| {
+        const sampling: ?Sampling = if (sampled) .{ .seed = 17 + i, .temperature = 1.0 } else null;
+        copies[i] = .{
+            .enabled = mode != .no_copies and (mode != .mixed or i % 2 == 0),
+            .stop = if (mode == .transition) prompt.len + 25 + i else if (mode == .single_copy_end) prompt.len + 7 else std.math.maxInt(usize),
+            .reject = mode == .rejected,
+            .sampling = sampling,
+        };
+        streams[i] = try sm.Stream.init(gpa, .{
+            .id = "copy-test",
+            .prompt = &prompt,
+            .max_new = @intCast(56 + i * 11),
+            .eos = &.{},
+            .sampling = sampling,
+            .drafts = true,
+            .proposer = copies[i].interface(),
+            .loop_guard = false,
+            .think_budget = if (mode == .budget and i % 2 == 0) 17 else 0,
+            .think_close = &.{ 90, 91, 92 },
+            .think_end = 91,
+        });
+        made += 1;
+        try e.addStream(&streams[i]);
+    }
+    var steps: usize = 0;
+    while (e.activeCount() > 0 and steps < 512) : (steps += 1) try e.step();
+    try std.testing.expectEqual(@as(usize, 0), e.activeCount());
+    var result: Result = .{ .calls = target.draft_calls, .drafted = target.drafted_streams };
+    errdefer result.deinit();
+    for (streams[0..n], 0..) |*s, i| {
+        result.tokens[i] = try gpa.dupe(u32, s.emitted());
+        result.reasons[i] = s.reason;
+    }
+    return result;
+}
+
+fn compare(a: Result, b: Result, n: usize) !void {
+    for (0..n) |i| {
+        try std.testing.expectEqualSlices(u32, a.tokens[i], b.tokens[i]);
+        try std.testing.expectEqual(a.reasons[i], b.reasons[i]);
+    }
+}
+
+test "lone stream copy skip preserves tokens/finishes and retains drafts on single_copy_end" {
+    for ([_]bool{ false, true }) |sampled| {
+        for (std.enums.values(Mode)) |mode| {
+            const baseline = try run(1, mode, sampled, false, false);
+            defer baseline.deinit();
+            const candidate = try run(1, mode, sampled, false, true);
+            defer candidate.deinit();
+            try compare(baseline, candidate, 1);
+            if (mode == .rejected or mode == .no_copies or mode == .single_copy_end) {
+                try std.testing.expectEqual(baseline.drafted, candidate.drafted);
+                try std.testing.expectEqual(baseline.calls, candidate.calls);
+            } else {
+                try std.testing.expect(candidate.drafted < baseline.drafted);
+            }
+        }
+    }
+}
+
+test "batch copy skip preserves tokens/finishes through misses, cuts, mixed streams and copy-to-head transitions" {
+    for ([_]usize{ 2, 4 }) |n| for ([_]bool{ false, true }) |sampled| {
+        for (std.enums.values(Mode)) |mode| {
+            const baseline = try run(n, mode, sampled, false, true);
+            defer baseline.deinit();
+            const candidate = try run(n, mode, sampled, true, true);
+            defer candidate.deinit();
+            try compare(baseline, candidate, n);
+            if (mode == .rejected or mode == .no_copies or mode == .single_copy_end) {
+                try std.testing.expectEqual(baseline.drafted, candidate.drafted);
+                try std.testing.expectEqual(baseline.calls, candidate.calls);
+            } else {
+                try std.testing.expect(candidate.drafted < baseline.drafted);
+            }
+        }
+    };
+}
+
+test "batch skip is opt-in and requires the existing copy-skip master switch" {
+    const baseline = try run(4, .copies, true, false, false);
+    defer baseline.deinit();
+    const disabled = try run(4, .copies, true, true, false);
+    defer disabled.deinit();
+    try compare(baseline, disabled, 4);
+    try std.testing.expectEqual(baseline.drafted, disabled.drafted);
+    try std.testing.expectEqual(baseline.calls, disabled.calls);
+}
